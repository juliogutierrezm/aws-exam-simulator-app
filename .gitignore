# ==============================
# Terraform
# ==============================
**/.terraform/

*.tfstate
*.tfstate.*
crash.log
crash.*.log

*.tfplan
*.plan

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example

# Terraform CLI config
.terraformrc
terraform.rc

# IMPORTANT:
# Do NOT ignore .terraform.lock.hcl
# It should be committed.

