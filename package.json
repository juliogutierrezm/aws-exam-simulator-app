{
  "name": "aws-saa-app",
  "version": "0.1.0",
  "description": "AWS Solutions Architect Associate exam preparation application",
  "private": true,
  "scripts": {
    "ng": "ng",
    "audit:data": "node scripts/audit-data.js",
    "generate:exam8": "node scripts/generate-exam-8.js",
    "audit:icons": "node scripts/audit-icons.js",
    "build:manifest": "node scripts/build-manifest.js",
    "sync:data": "node scripts/sync-data.js",
    "sync:icons": "node scripts/sync-icons.js",
    "prepare:app": "npm run audit:data && npm run audit:icons && npm run build:manifest && npm run sync:data && npm run sync:icons",
    "dev": "npm run prepare:app && ng serve",
    "start": "ng serve",
    "build": "npm run prepare:app && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@primeuix/themes": "^3.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.11",
    "@angular/cli": "^20.3.11",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
