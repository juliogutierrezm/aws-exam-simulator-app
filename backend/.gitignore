node_modules/
backend/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================
# Angular
# ==============================
dist/
.angular/
.cache/

# ==============================
# Backend build output
# ==============================
backend/dist/
backend/.artifacts/
backend/coverage/

# ==============================
# Environment variables
# ==============================
.env
.env.*
!.env.example

backend/.env
backend/.env.*
